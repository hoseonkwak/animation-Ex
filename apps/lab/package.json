{
  "name": "@kwak-motion/lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts --passWithNoTests",
    "test:ingestion": "vitest run tests/ingestion --passWithNoTests",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:legacy-previews": "node scripts/verify-legacy-previews.mjs",
    "db:migrate:local": "wrangler d1 migrations apply kwak-motion-lab-local --local",
    "db:seed:local": "wrangler d1 execute kwak-motion-lab-local --local --file db/seeds/wp1.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "5.20260915.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "26.5.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11",
    "wrangler": "4.131.2"
  }
}
