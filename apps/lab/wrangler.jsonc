{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kwak-motion-lab",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/robots.txt"],
  },
  "vars": {
    "APP_ENVIRONMENT": "local",
    "LOCAL_ADMIN_SIMULATION": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwak-motion-lab-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "kwak-motion-lab-preview",
      "vars": {
        "APP_ENVIRONMENT": "preview",
        "LOCAL_ADMIN_SIMULATION": "false",
        "INGESTION_PAUSED": "true",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwak-motion-lab-preview",
          "migrations_dir": "db/migrations",
        },
      ],
    },
    "production": {
      "name": "kwak-motion-lab-production",
      "vars": {
        "APP_ENVIRONMENT": "production",
        "LOCAL_ADMIN_SIMULATION": "false",
        "INGESTION_PAUSED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwak-motion-lab-production",
          "migrations_dir": "db/migrations",
        },
      ],
    },
  },
}
